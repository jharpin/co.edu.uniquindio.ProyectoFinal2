<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="imgLogin" prefHeight="414.0" prefWidth="594.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyecto.viewController.LoginViewController">
   <children>
      <Label fx:id="lblLogintl" layoutX="228.0" layoutY="58.0" text="Login Usuarios ">
         <font>
            <Font name="Dubai Regular" size="20.0" />
         </font>
      </Label>
      <Label fx:id="lblBilleteraVirtual" layoutX="201.0" layoutY="14.0" text="Billetera Virtual ">
         <font>
            <Font name="Dubai Bold" size="24.0" />
         </font>
      </Label>

      <Label fx:id="lblIdentificacionLogin" layoutX="173.0" layoutY="103.0" text="Identificacion">
         <font>
            <Font name="Dubai Regular" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="txtIdentificacionLogin" layoutX="174.0" layoutY="133.0" prefHeight="30.0" prefWidth="222.0" />
      <Label fx:id="lblContraseniaLogin" layoutX="173.0" layoutY="175.0" text="Contraseña">
         <font>
            <Font name="Dubai Regular" size="16.0" />
         </font>
      </Label>
      <Button fx:id="btnLogin" layoutX="225.0" layoutY="280.0" mnemonicParsing="false" onAction="#IngresarLogin" prefHeight="44.0" prefWidth="142.0" text="Ingresar">
         <textFill>
            <RadialGradient centerX="0.4203539738612892" centerY="0.5265151442903461" radius="1.0">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.14105263352394104" green="0.21263158321380615" blue="0.28421053290367126" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="1.0" green="1.0" blue="1.0" />
                     </color>
                  </Stop>
               </stops>
            </RadialGradient>
         </textFill>
         <font>
            <Font name="Book Antiqua" size="12.0" />
         </font></Button>
      <Hyperlink fx:id="linkRegistrarCuenta" layoutX="244.0" layoutY="245.0" onAction="#irARegistroUsuario" text="Registrar cuenta" />
      <PasswordField fx:id="txtContraseniaLogin" layoutX="170.0" layoutY="205.0" prefHeight="30.0" prefWidth="229.0" />
   </children>
</AnchorPane>
