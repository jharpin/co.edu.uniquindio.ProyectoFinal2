<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="imgLogin" prefHeight="465.0" prefWidth="608.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyecto.viewController.LoginViewController">
   <children>
      <Label fx:id="lblLogintl" layoutX="240.0" layoutY="58.0" text="Login Usuarios ">
         <font>
            <Font name="Dubai Regular" size="20.0" />
         </font>
      </Label>
      <Label fx:id="lblBilleteraVirtual" layoutX="214.0" layoutY="14.0" text="Billetera Virtual ">
         <font>
            <Font name="Dubai Bold" size="24.0" />
         </font>
      </Label>

      <Label fx:id="lblIdentificacionLogin" layoutX="170.0" layoutY="115.0" text="Identificacion">
         <font>
            <Font name="Dubai Regular" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="txtIdentificacionLogin" layoutX="170.0" layoutY="163.0" prefHeight="30.0" prefWidth="222.0" />
      <Label fx:id="lblContraseniaLogin" layoutX="170.0" layoutY="203.0" text="Contraseña">
         <font>
            <Font name="Dubai Regular" size="16.0" />
         </font>
      </Label>
      <Button fx:id="btnLogin" layoutX="244.0" layoutY="327.0" mnemonicParsing="false" onAction="#IngresarLogin" prefHeight="44.0" prefWidth="142.0" text="Ingresar" textFill="#3315a9">
         <font>
            <Font name="Dubai Regular" size="12.0" />
         </font></Button>
      <Hyperlink fx:id="linkRegistrarCuenta" layoutX="252.0" layoutY="278.0" onAction="#irARegistroUsuario" text="Registrar cuenta">
         <font>
            <Font name="Dubai Regular" size="14.0" />
         </font></Hyperlink>
      <PasswordField fx:id="txtContraseniaLogin" layoutX="170.0" layoutY="247.0" prefHeight="30.0" prefWidth="229.0" />
   </children>
</AnchorPane>
