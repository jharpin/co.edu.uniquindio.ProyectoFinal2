<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="626.0" prefWidth="778.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyecto.viewController.TransaccionViewController">

   <children>

      <!-- TÍTULOS -->
      <Label fx:id="lblTitulo" layoutX="318.0" layoutY="14.0" text="Billetera Virtual">
         <font>
            <Font name="Dubai Bold" size="24" />
         </font>
      </Label>

      <Label fx:id="lblSubtitulo" layoutX="306.0" layoutY="58.0" text="Gestión de Transacciones">
         <font>
            <Font name="Dubai Regular" size="18" />
         </font>
      </Label>

      <!-- CAMPOS -->
      <Label layoutX="50.0" layoutY="110.0" text="Cuenta Origen:" />
      <TextField fx:id="cuentaOrigenField" layoutX="180.0" layoutY="105.0" />

      <Label layoutX="50.0" layoutY="150.0" text="Cuenta Destino:" />
      <TextField fx:id="cuentaDestinoField" layoutX="180.0" layoutY="145.0" />

      <Label layoutX="50.0" layoutY="190.0" text="Monto:" />
      <TextField fx:id="montoField" layoutX="180.0" layoutY="185.0" />

      <Label layoutX="50.0" layoutY="230.0" text="Tipo de Transacción:" />
      <ComboBox fx:id="tipoComboBox" layoutX="180.0" layoutY="225.0" />

      <Label layoutX="267.0" layoutY="229.0" text="Categoría:" />
      <ComboBox fx:id="categoriaComboBox" layoutX="330.0" layoutY="226.0" />

      <Label layoutX="102.0" layoutY="297.0" text="Descripción:" />
      <TextArea fx:id="descripcionArea" layoutX="179.0" layoutY="284.0" prefColumnCount="20" prefHeight="44.0" prefRowCount="3" prefWidth="240.0" />

      <Button fx:id="btnEnviar" layoutX="336.0" layoutY="350.0" onAction="#onEnviar" text="Enviar Dinero" />

      <!-- FILTROS -->
      <Label layoutX="450.0" layoutY="110.0" text="Filtrar por Fecha:" />
      <DatePicker fx:id="filtroFechaPicker" layoutX="580.0" layoutY="105.0" />

      <Label layoutX="450.0" layoutY="150.0" text="Filtrar por Tipo:" />
      <ComboBox fx:id="filtroTipoComboBox" layoutX="580.0" layoutY="145.0" />

      <Label layoutX="450.0" layoutY="190.0" text="Filtrar por Categoría:" />
      <TextField fx:id="filtroCategoriaField" layoutX="580.0" layoutY="185.0" />

      <Button fx:id="filtrarButton" layoutX="611.0" layoutY="225.0" text="Aplicar Filtros" />

      <!-- TABLA -->
      <TableView fx:id="tablaTransacciones" layoutX="50.0" layoutY="394.0" prefHeight="159.0" prefWidth="700.0">
         <columns>
            <TableColumn fx:id="colIdTrans" text="ID Transacción" />
            <TableColumn fx:id="colCuentaOrigen" text="Cuenta Origen" />
            <TableColumn fx:id="colCuentaDestino" text="Cuenta Destino" />
            <TableColumn fx:id="colValorTransferido" text="Valor Transferido" />
            <TableColumn fx:id="colFechaTrans" text="Fecha" />
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colCategoria" text="Categoría" />
         </columns>
      </TableView>

      <!-- DETALLES -->
      <Button fx:id="verDetallesButton" layoutX="285.0" layoutY="566.0" text="Ver Detalles de la Transacción Seleccionada" />

   </children>
</AnchorPane>
