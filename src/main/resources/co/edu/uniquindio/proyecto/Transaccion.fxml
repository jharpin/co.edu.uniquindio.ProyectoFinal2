<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyecto.viewController.TransaccionViewController">

   <children>

      <!-- TÍTULOS -->
      <Label fx:id="lblTitulo" layoutX="280.0" layoutY="20.0" text="Billetera Virtual">
         <font>
            <Font name="Dubai Bold" size="24"/>
         </font>
      </Label>

      <Label fx:id="lblSubtitulo" layoutX="280.0" layoutY="60.0" text="Gestión de Transacciones">
         <font>
            <Font name="Dubai Regular" size="18"/>
         </font>
      </Label>

      <!-- CAMPOS -->
      <Label layoutX="50.0" layoutY="110.0" text="Cuenta Origen:"/>
      <TextField fx:id="cuentaOrigenField" layoutX="180.0" layoutY="105.0"/>

      <Label layoutX="50.0" layoutY="150.0" text="Cuenta Destino:"/>
      <TextField fx:id="cuentaDestinoField" layoutX="180.0" layoutY="145.0"/>

      <Label layoutX="50.0" layoutY="190.0" text="Monto:"/>
      <TextField fx:id="montoField" layoutX="180.0" layoutY="185.0"/>

      <Label layoutX="50.0" layoutY="230.0" text="Tipo de Transacción:"/>
      <ComboBox fx:id="tipoComboBox" layoutX="180.0" layoutY="225.0"/>

      <Label layoutX="50.0" layoutY="270.0" text="Categoría:"/>
      <ComboBox fx:id="categoriaComboBox" layoutX="180.0" layoutY="265.0"/>

      <Label layoutX="50.0" layoutY="310.0" text="Descripción:"/>
      <TextArea fx:id="descripcionArea" layoutX="180.0" layoutY="305.0" prefRowCount="3" prefColumnCount="20"/>

      <Button fx:id="btnEnviar" layoutX="180.0" layoutY="380.0" text="Enviar Dinero" onAction="#onEnviar"/>

      <!-- FILTROS -->
      <Label layoutX="450.0" layoutY="110.0" text="Filtrar por Fecha:"/>
      <DatePicker fx:id="filtroFechaPicker" layoutX="580.0" layoutY="105.0"/>

      <Label layoutX="450.0" layoutY="150.0" text="Filtrar por Tipo:"/>
      <ComboBox fx:id="filtroTipoComboBox" layoutX="580.0" layoutY="145.0"/>

      <Label layoutX="450.0" layoutY="190.0" text="Filtrar por Categoría:"/>
      <TextField fx:id="filtroCategoriaField" layoutX="580.0" layoutY="185.0"/>

      <Button fx:id="filtrarButton" layoutX="580.0" layoutY="225.0" text="Aplicar Filtros"/>

      <!-- TABLA -->
      <TableView fx:id="tablaTransacciones" layoutX="50.0" layoutY="430.0" prefHeight="200.0" prefWidth="700.0">
         <columns>
            <TableColumn fx:id="colIdTrans" text="ID Transacción"/>
            <TableColumn fx:id="colCuentaOrigen" text="Cuenta Origen"/>
            <TableColumn fx:id="colCuentaDestino" text="Cuenta Destino"/>
            <TableColumn fx:id="colValorTransferido" text="Valor Transferido"/>
            <TableColumn fx:id="colFechaTrans" text="Fecha"/>
            <TableColumn fx:id="colTipo" text="Tipo"/>
            <TableColumn fx:id="colCategoria" text="Categoría"/>
         </columns>
      </TableView>

      <!-- DETALLES -->
      <Button fx:id="verDetallesButton" layoutX="300.0" layoutY="640.0" text="Ver Detalles de la Transacción Seleccionada"/>

   </children>
</AnchorPane>
