<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gestionempleadofx.proyecto.DashboardUsuario">
   <children>
      <TabPane prefHeight="436.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab fx:id="tabPerfil" text="Perfil ">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="410.0" prefWidth="620.0">
                     <children>
                        <Label fx:id="lblBilleteraVirtual" layoutX="216.0" layoutY="14.0" text="Billetera Virtual ">
                           <font>
                              <Font name="Dubai Bold" size="24.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblnombreUsuario" layoutX="37.0" layoutY="78.0" text="nombreUsuario:">
                           <font>
                              <Font name="Dubai Regular" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblnombreInfo" layoutX="156.0" layoutY="84.0" prefHeight="26.0" prefWidth="130.0" />
                        <Label fx:id="lblTelefonoUsuario" layoutX="331.0" layoutY="78.0" text="telefonoUsuario:">
                           <font>
                              <Font name="Dubai Regular" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblinfoTelefono" layoutX="447.0" layoutY="79.0" prefHeight="30.0" prefWidth="124.0" />
                        <Button fx:id="btnActualizarUsuario" layoutX="240.0" layoutY="138.0" mnemonicParsing="false" onAction="#onActualizar" prefHeight="38.0" prefWidth="120.0" text="Actualizar Datos" />
                        <Label fx:id="lblRegistroTl" layoutX="244.0" layoutY="186.0" text="Datos cuenta ">
                           <font>
                              <Font name="Dubai Regular" size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblnombreUsuario1" layoutX="52.0" layoutY="221.0" text="numero de cuenta: ">
                           <font>
                              <Font name="Dubai Regular" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblNumeroCuenta" layoutX="190.0" layoutY="222.0" prefHeight="26.0" prefWidth="130.0" />
                        <Label fx:id="lblnombreUsuario11" layoutX="52.0" layoutY="251.0" text="Dinero en Cuenta: ">
                           <font>
                              <Font name="Dubai Regular" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblnumeroDinero" layoutX="200.0" layoutY="252.0" prefHeight="26.0" prefWidth="130.0" />
                        <Button fx:id="btnAgregarDinero" layoutX="130.0" layoutY="314.0" mnemonicParsing="false" onAction="#onAgregarDinero" prefHeight="38.0" prefWidth="120.0" text="Agregar Dinero" />
                        <Button fx:id="btnRetirarDinero" layoutX="270.0" layoutY="314.0" mnemonicParsing="false" onAction="#Retirar" prefHeight="38.0" prefWidth="120.0" text="Retirar Dinero" />
                        <Button fx:id="btnTranferir" layoutX="406.0" layoutY="314.0" mnemonicParsing="false" onAction="#onTransferir" prefHeight="38.0" prefWidth="120.0" text="Transferir Dinero" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab fx:id="tabCuenta" text="Cuentas">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </content>
          </Tab>
            <Tab fx:id="tabTransacciones" text="Transacciones">
               <content>
                  <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
